rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      // Somente o usuário autenticado pode acessar seus dados de perfil.
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /tasks/{taskId} {
        // Mantém a leitura dos dados legados para a migração sem permitir novas alterações.
        allow read: if request.auth != null && request.auth.uid == userId;
      }

      match /migrations/{migrationId} {
        // O estado de migração é privado e coordenado entre sessões do mesmo usuário.
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /boards/{boardId} {
      function isOwnerAfterWrite() {
        return request.auth != null &&
          getAfter(/databases/$(database)/documents/boards/$(boardId)).data.ownerUid == request.auth.uid;
      }

      function isOwner() {
        return request.auth != null &&
          get(/databases/$(database)/documents/boards/$(boardId)).data.ownerUid == request.auth.uid;
      }

      allow get, list: if request.auth != null &&
        resource != null &&
        resource.data.ownerUid == request.auth.uid;
      allow create: if request.auth != null &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 100 &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.updatedAt is timestamp;
      allow update: if request.auth != null &&
        resource.data.ownerUid == request.auth.uid &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 100;
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;

      match /columns/{columnId} {
        allow read: if isOwner();
        allow create: if isOwnerAfterWrite() &&
          request.resource.data.name is string &&
          request.resource.data.name.size() > 0 &&
          request.resource.data.name.size() <= 100 &&
          request.resource.data.order is int;
        allow update: if isOwner() &&
          request.resource.data.name is string &&
          request.resource.data.name.size() > 0 &&
          request.resource.data.name.size() <= 100 &&
          request.resource.data.order is int;
        allow delete: if isOwner();
      }

      match /tasks/{taskId} {
        allow read: if isOwner();
        allow create, update: if isOwnerAfterWrite() &&
          request.resource.data.title is string &&
          request.resource.data.title.size() > 0 &&
          request.resource.data.columnId is string &&
          exists(/databases/$(database)/documents/boards/$(boardId)/columns/$(request.resource.data.columnId)) &&
          (!("description" in request.resource.data) ||
            request.resource.data.description is string ||
            request.resource.data.description == null) &&
          (!("status" in request.resource.data) || request.resource.data.status is string);
        allow delete: if isOwner();
      }
    }
  }
}
